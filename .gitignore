# Converter / scorer output. Regenerate with `make evals`; never commit.
out/
out-*/
artifacts/

# Local skill-content registry, rebuilt from the traces by `make evals`.
# Commit it only if you need the bodies without the traces to hand.
skills/

# Redaction lists are a catalogue of exactly the customer data we are
# removing — never commit one. Keep them beside the raw export, outside the
# repo, or in a secret store.
redact*.json
reviewed*.json
*.redactions.json

# Replay cassettes, rebuilt from the traces by `make cassettes`. Commit one
# only when it backs a gate and the trace it came from is not committed.
cassettes/

# Unattended export landing zone. Raw traces that matter get curated into
# traces/ by hand with a dated name and a line in traces/README.md.
traces/auto/
.export-state.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
