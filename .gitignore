# Converter / scorer output. Regenerate with `make evals`; never commit.
out/
out-*/
artifacts/

# Local skill-content registry, rebuilt from the traces by `make evals`.
# Commit it only if you need the bodies without the traces to hand.
skills/

# Redaction lists are a catalogue of exactly the customer data we are
# removing — never commit one. Keep them beside the raw export, outside the
# repo, or in a secret store. `--learn` writes one of these, and the name it
# is given is whatever the caller passes, so cover the names the docs use.
redact*.json
reviewed*.json
candidates*.json
*-candidates.json
scrub-*.json
*.redactions.json

# Assembled Azure Function deployment package. Every file in it is a copy of
# something that lives elsewhere; `functions/replay-mcp/build.sh` rebuilds it.
functions/replay-mcp/.build/

# Replay cassettes, rebuilt from the traces by `make cassettes`. Commit one
# only when it backs a gate and the trace it came from is not committed.
cassettes/

# Unattended export landing zone. Raw traces that matter get curated into
# traces/ by hand with a dated name and a line in traces/README.md.
traces/auto/
.export-state.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS

.idea/
.DS_Store
Thumbs.db

# Scratch parameter files for `az ad app federated-credential create`. No
# secret in them -- name, issuer, subject, audience -- but they are scratch
# and belong in the temp directory. See docs/CREDENTIALS.md.
fed-*.json

# docs/HISTORY-PURGE.md's working copies. They belong outside the clone; if
# the runbook is run from inside one, they must still never be committed.
purge.git/
check/
